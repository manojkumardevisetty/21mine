# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twentyonemine?schema=public"

# ---------- Auth (generate with: openssl rand -base64 32) ----------
AUTH_SECRET="replace-with-32+-random-bytes"
# Public base URL of the site (no trailing slash)
# Production: https://21mine.shop
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Secret for signed guest order / invoice links (openssl rand -base64 32)
ORDER_LINK_SECRET="replace-with-another-random-secret"

# ---------- Mode ----------
# "demo" shows simulated payments + demo banners. Set to "production" for launch.
STORE_MODE="demo"

# ---------- Email (password reset, order confirmation) ----------
# Leave SMTP_HOST empty in demo: emails are written to the Dev Outbox (Admin > Outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="21mine <support@21mine.shop>"

# ---------- Payments ----------
# "simulated" in demo. A live provider id (e.g. "hosted") only after gateway approval.
PAYMENT_PROVIDER="simulated"
# Currencies the live gateway accepts (comma separated). Empty = all enabled store currencies.
GATEWAY_CURRENCIES=""
# Live gateway credentials (server-side only - never NEXT_PUBLIC_)
GATEWAY_API_BASE=""
GATEWAY_API_KEY=""
GATEWAY_WEBHOOK_SECRET=""
# Comma separated, only after the gateway confirms them: card,apple_pay,google_pay
GATEWAY_ENABLED_METHODS=""

# Where new-order notifications are sent
STORE_NOTIFY_EMAIL="info@21mine.shop"

# Protects /api/cron/expire-orders (call every 10-15 min to release unpaid orders' stock)
CRON_SECRET="replace-with-random-secret"

# ---------- First admin account (used once by `npm run db:seed`) ----------
SEED_ADMIN_EMAIL="info@21mine.shop"
# Leave empty to generate a random password (printed once by the seed)
SEED_ADMIN_PASSWORD=""

# ---------- Uploads ----------
# Folder for admin-uploaded product photos (must be persistent storage in production)
UPLOAD_DIR="./uploads"
