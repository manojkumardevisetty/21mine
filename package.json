{
  "name": "21mine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset.ts",
    "test": "vitest run",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts",
    "vercel-build": "npm run db:migrate && npm run db:seed && next build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.19.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
